# Backend Environment Variables
# Copy this file to .env and fill in real values

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net/dbname"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="your_super_secure_jwt_secret_here"
JWT_EXPIRE="7d"

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-gmail-app-password"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your deployed frontend URL (e.g. https://rj-developer.vercel.app)
FRONTEND_URL="https://rjdeveloper-2ybv.vercel.app"
BACKEND_URL="https://rjdeveloper-one.vercel.app"

# ── OAuth ────────────────────────────────────────────────────────────────────
# GOOGLE_CALLBACK_URL (Optional): Use this if you want to override the default 
# default is: ${BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="https://rjdeveloper-one.vercel.app/api/auth/google/callback"
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"

# ── Frontend ──────────────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ── Local Dev ─────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
